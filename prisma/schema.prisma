generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Supplier {
  id        Int      @id @default(autoincrement())
  name      String
  contact   String?
  notes     String?
  createdAt DateTime @default(now())
  phones    Phone[]
}

model Phone {
  id            Int       @id @default(autoincrement())
  brand         String
  model         String
  storage       String?
  color         String?
  condition     String
  imei          String?   @unique
  serial        String?   @unique
  purchasePrice Float
  askingPrice   Float?
  status        String    @default("for_sale")
  purchaseDate  DateTime
  purchasedFrom String?
  supplierId    Int?
  supplier      Supplier? @relation(fields: [supplierId], references: [id])
  notes         String?
  repairNeeded  String?
  city          String?
  imageUrl      String?
  soldDate      DateTime?
  salePrice     Float?
  soldTo        String?
  repairs       Repair[]
  orderItems    OrderItem[]
  daveCarePlans DaveCarePlan[]
  reviews       Review[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([status])
  @@index([brand, model])
}

model Repair {
  id          Int      @id @default(autoincrement())
  phoneId     Int
  phone       Phone    @relation(fields: [phoneId], references: [id], onDelete: Cascade)
  serviceType String
  description String?
  partCost    Float?
  laborCost   Float?
  performedBy String?
  performedAt DateTime @default(now())
}

model Part {
  id             Int      @id @default(autoincrement())
  name           String
  category       String
  compatibleWith String
  brand          String?
  price          Float
  stock          Int      @default(0)
  imageUrl       String?
  description    String?
  orderItems     OrderItem[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([category])
}

model Order {
  id             Int       @id @default(autoincrement())
  orderNumber    String    @unique
  customerName   String
  customerEmail  String
  customerPhone  String?
  addressLine1   String
  addressLine2   String?
  city           String
  province       String
  postalCode     String
  country        String    @default("CA")
  customerNotes  String?
  status         String    @default("pending_payment")
  subtotal       Float
  discountCodeId Int?
  discountCode   DiscountCode? @relation(fields: [discountCodeId], references: [id])
  discountAmount Float     @default(0)
  shippingCost   Float
  taxAmount      Float
  total          Float
  paymentMethod  String?
  trackingNumber String?
  carrier        String?
  adminNotes     String?
  paidAt         DateTime?
  shippedAt      DateTime?
  deliveredAt    DateTime?
  cancelledAt    DateTime?
  // Marketing consent (CASL)
  smsOptIn               Boolean   @default(false)
  smsOptInAt             DateTime?
  marketingUnsubscribedAt DateTime?
  items          OrderItem[]
  daveCarePlans  DaveCarePlan[]
  reviews        Review[]
  campaignSends  EmailCampaignSend[]
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([status])
  @@index([customerEmail])
  @@index([orderNumber])
}

model OrderItem {
  id        Int     @id @default(autoincrement())
  orderId   Int
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  itemType  String
  phoneId   Int?
  phone     Phone?  @relation(fields: [phoneId], references: [id])
  partId    Int?
  part      Part?   @relation(fields: [partId], references: [id])
  name      String
  unitPrice Float
  quantity  Int     @default(1)
}

model Settings {
  id                    Int      @id @default(1)
  shippingFlatRate      Float    @default(15.00)
  freeShippingThreshold Float?
  updatedAt             DateTime @updatedAt
}

model DiscountCode {
  id              Int       @id @default(autoincrement())
  code            String    @unique
  description     String?
  discountType    String
  discountValue   Float
  minOrderAmount  Float?
  maxUses         Int?
  usedCount       Int       @default(0)
  active          Boolean   @default(true)
  expiresAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  orders          Order[]
}

model DaveCarePlan {
  id            Int       @id @default(autoincrement())
  orderId       Int
  order         Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  phoneId       Int?
  phone         Phone?    @relation(fields: [phoneId], references: [id])
  customerEmail String
  customerName  String
  phoneLabel    String
  planType      String
  pricePaid     Float
  startedAt     DateTime  @default(now())
  expiresAt     DateTime?
  status        String    @default("active")
  batteryUsed   Boolean   @default(false)
  cameraUsed    Boolean   @default(false)
  screenUsed    Boolean   @default(false)
  backGlassUsed Boolean   @default(false)
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([customerEmail])
  @@index([status])
}

model BlogPost {
  id          Int       @id @default(autoincrement())
  slug        String    @unique
  title       String
  excerpt     String?
  // Markdown body. Rendered server-side with a light markdown-to-HTML pass.
  content     String
  coverImage  String?
  // SEO
  metaTitle   String?
  metaDesc    String?
  keywords    String?   // comma-separated
  // Lifecycle
  publishedAt DateTime?
  author      String?   @default("Dave's Mobile Shop")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([publishedAt])
}

model Review {
  id            Int       @id @default(autoincrement())
  orderId       Int?
  order         Order?    @relation(fields: [orderId], references: [id], onDelete: SetNull)
  phoneId       Int?
  phone         Phone?    @relation(fields: [phoneId], references: [id], onDelete: SetNull)
  customerName  String
  customerEmail String
  rating        Int       // 1-5
  title         String?
  body          String
  // Photo URLs uploaded via /api/reviews/upload (Vercel Blob)
  photos        String[]  @default([])
  // approved (default) | hidden by admin | flagged
  status        String    @default("approved")
  adminNotes    String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([phoneId, status])
  @@index([status])
  @@index([createdAt])
}

model EmailCampaignSend {
  id        Int      @id @default(autoincrement())
  orderId   Int
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  campaign  String   // "dave_care_drip" | "review_prompt"
  step      Int      // 1, 2, 3, 4 (drip) | 1, 2 (review)
  sentAt    DateTime @default(now())

  @@unique([orderId, campaign, step])
  @@index([campaign, sentAt])
}

model SmsLog {
  id          Int       @id @default(autoincrement())
  // Outbound or inbound
  direction   String    // "out" | "in"
  // E.164 format
  toNumber    String?
  fromNumber  String?
  body        String
  // Optional ties
  orderId     Int?
  // For broadcasts: groups all sends from one admin push
  broadcastId String?
  // Twilio's response: status (queued, sending, sent, delivered, failed), sid, error code
  twilioSid   String?
  status      String?
  error       String?
  campaign    String?   // "shipped" | "delivered" | "broadcast" | "stop_reply" | "help_reply" | "inbound"
  sentAt      DateTime  @default(now())

  @@index([toNumber])
  @@index([broadcastId])
  @@index([sentAt])
}
