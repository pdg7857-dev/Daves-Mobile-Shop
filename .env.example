# Anthropic
ANTHROPIC_API_KEY=

# Meta Messenger Platform
MESSENGER_VERIFY_TOKEN=change-me
MESSENGER_PAGE_ACCESS_TOKEN=
MESSENGER_APP_SECRET=

# Bot behavior
BUSINESS_NAME=Dave's Mobile Shop
BUSINESS_HOURS=Mon-Sat 9am-6pm
BOT_MODEL=claude-sonnet-4-6
BOT_MAX_TOKENS=1024

# Storage: "sqlite" (default, persists to DB_PATH) or "memory"
STORE_BACKEND=sqlite
DB_PATH=data/shop.db

# Admin dashboard (HTTP Basic auth at /admin). Leave ADMIN_PASSWORD blank to
# disable the dashboard entirely (returns 503 until you set one).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
