# =========================================================================
# REQUIRED — the site won't boot or login won't work without these.
# =========================================================================

# Postgres connection string. Use Neon (recommended), Vercel Postgres,
# Supabase, Railway, etc. For local dev with Docker:
#   docker run --name dms-pg -e POSTGRES_PASSWORD=postgres -p 5432:5432 -d postgres:16
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/daves_mobile_shop?schema=public"

# Plain-text admin login password (used at /admin). Pick something long.
ADMIN_PASSWORD="change-me"

# Session cookie signing secret. Must be >= 16 chars; 64-char hex recommended.
# Generate with: openssl rand -hex 32
SESSION_SECRET="replace-with-32-byte-random-hex"

# =========================================================================
# PUBLIC (NEXT_PUBLIC_*) — shipped to the browser. Optional but recommended.
# =========================================================================

# Phone + email shown in the site header, footer, and contact page.
NEXT_PUBLIC_BUSINESS_PHONE="+1-555-555-0123"
NEXT_PUBLIC_BUSINESS_EMAIL="hello@davesmobileshop.ca"

# Canonical site URL for sitemap.xml + robots.txt + JSON-LD.
# Set this to your production domain. Falls back to VERCEL_URL otherwise.
NEXT_PUBLIC_SITE_URL="https://davesmobileshop.ca"

# =========================================================================
# AUTOMATIC ON VERCEL — do NOT set these manually.
# =========================================================================
# BLOB_READ_WRITE_TOKEN — auto-injected when you connect a Vercel Blob store
#                         (Project → Storage → Create → Blob). Required for
#                         photo uploads in the admin.
# VERCEL_URL              — auto-injected on every deployment.
# NODE_ENV                — auto-set to "production" on Vercel builds.

# =========================================================================
# OPTIONAL — only set if you're using the Google Sheets sync feature.
# Leave these blank to skip Sheets sync; the app degrades gracefully.
# =========================================================================
# GOOGLE_SHEET_ID="1AbCdEfGhIjKlMnOpQrStUvWxYz"
# GOOGLE_SERVICE_ACCOUNT_JSON='{"type":"service_account",...}'
