# Postgres connection for the todo app's own database
DATABASE_URL="postgresql://user:pass@host:5432/todo_app"

# Read-only Postgres connection to the daves-mobile-shop database
# Used to pull Order + DaveCarePlan records as tasks.
MOBILE_SHOP_DATABASE_URL="postgresql://reader:pass@host:5432/daves_mobile_shop"

# Toyota backend REST API.
# Used to pull Customer records (leads, follow-ups) as tasks.
TOYOTA_API_BASE="https://toyota-backend.example.com"
TOYOTA_API_TOKEN="paste-bearer-token-here"

# Optional deep links into source admin panels (used in task cards).
MOBILE_SHOP_ADMIN_URL="https://daves-mobile-shop.example.com/admin"
TOYOTA_ADMIN_URL="https://toyota-backend.example.com/admin"

# Shared secret required to call the /api/cron endpoint.
CRON_SECRET="change-me-to-a-random-string"
